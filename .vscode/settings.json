{
  // Formatting
  "ruby.format": "rufo",
  "editor.formatOnSave": true,

  // Run Rufo via Bundler when available
  "ruby.rufo.useBundler": true,

  // Keep RuboCop linting enabled (optional) and run via Bundler
  "ruby.lint": {
    "rubocop": true
  },
  "ruby.lint.rubocop": {
    "useBundler": true,
    "lintOnSave": true,
    "config": ".rubocop.yml"
  },
  "cSpell.words": [
    "ampm",
    "destime",
    "noda",
    "Okada",
    "oxnode",
    "stime",
    "suntime",
    "suntimes",
    "susee",
    "suseejs",
    "thetkarit"
  ]
}
